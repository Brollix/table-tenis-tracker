{
  "expo": {
    "name": "Tracker TDM",
    "slug": "tt-app",
    "scheme": "ttapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agusb.trackertdm"
    },
    "android": {
      "package": "com.agusb.trackertdm",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-router",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "77c99e2e-1882-445d-badb-e5cb65405858"
      }
    }
  }
}
